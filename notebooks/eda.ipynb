   "source": [
    "accidents_per_ruc = df.groupby('RUCC_2023').size()\n",
    "pop_per_ruc = df.drop_duplicates(subset = 'FIPS').groupby('RUCC_2023')['Population_2020'].sum()\n",
    "\n",
    "temp = ((accidents_per_ruc / pop_per_ruc) * 100000).reset_index().rename(columns = {0: 'Accidents_Per_100k'})\n",
    "temp['RUCC_2023'] = temp['RUCC_2023'].astype('category')\n",
    "fig = px.bar(temp, y = 'RUCC_2023', x = 'Accidents_Per_100k', color = 'RUCC_2023')\n",
    "fig.show()"
   ]
  },
