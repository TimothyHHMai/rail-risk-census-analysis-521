    "                        lon = \"Longitude\", \n",
    "                        hover_name = \"Reporting Railroad Name\",\n",
    "                        hover_data = ['Date', 'Total Damage Cost'],\n",
    "                        size = \"Total Damage Cost\", \n",
    "                        color = \"Cause_Category\", \n",
    "                        zoom = 3,\n",
    "                        mapbox_style = \"carto-positron\", \n",
    "                        title = \"Hazmat Accidents\",\n",
    "                        height = 800\n",
    "                        )\n",
    "fig.show()"
   ]
